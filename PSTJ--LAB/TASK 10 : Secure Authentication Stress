import java.util.HashMap;
import java.util.Map;

public class SecureAuthentication {

    private final Map<String, String> users = new HashMap<>();
    private final Map<String, Integer> failedAttempts = new HashMap<>();

    public void register(String username, String password) {
        users.put(username, password);
        failedAttempts.put(username, 0);
    }

    public boolean login(String username, String password) {
        if (!users.containsKey(username)) {
            return false;
        }

        if (failedAttempts.get(username) >= 5) {
            return false;
        }

        if (users.get(username).equals(password)) {
            failedAttempts.put(username, 0);
            return true;
        }

        failedAttempts.put(username, failedAttempts.get(username) + 1);
        return false;
    }

    public void runStressTest() {
        register("krishna", "Pass123");

        int successfulLogins = 0;
        int failedLogins = 0;

        long startTime = System.currentTimeMillis();

        for (int i = 0; i < 10000; i++) {
            if (login("krishna", "WrongPass")) {
                successfulLogins++;
            } else {
                failedLogins++;
            }
        }

        long endTime = System.currentTimeMillis();

        System.out.println("\n--- Authentication Stress Test ---");
        System.out.println("Total Login Attempts: 10000");
        System.out.println("Successful Logins: " + successfulLogins);
        System.out.println("Failed Logins: " + failedLogins);
        System.out.println("Execution Time: " + (endTime - startTime) + " ms");
        System.out.println("Account Locked: "
                + (failedAttempts.get("krishna") >= 5));
    }

    public static void main(String[] args) {
        SecureAuthentication auth = new SecureAuthentication();

        auth.register("krishna", "Pass123");

        System.out.println("Valid Login: "
                + auth.login("krishna", "Pass123"));

        System.out.println("Invalid Login: "
                + auth.login("krishna", "WrongPass"));

        System.out.println("Failed Attempts: "
                + auth.failedAttempts.get("krishna"));

        auth.runStressTest();
    }
}
